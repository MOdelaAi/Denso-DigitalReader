# CMake out-of-source build dirs
/build
/build-*
/out
/cmake-build-*

# Runtime SQLite store (created next to the executable)
denso.db
denso.db-shm
denso.db-wal

# Screenshots / generated images (assets/icon.png is force-tracked)
*.png

# ONNX Runtime binaries (provisioned per platform, not tracked)
third_party/onnxruntime/

# CUDA execution-provider runtime DLLs (TensorRT + cuDNN), provisioned locally
# and copied beside the exe at build time — see docs/GPU_SETUP.md. Not tracked.
third_party/gpu_ep/

# TensorRT engines + their class-name sidecars + the ORT TensorRT-EP engine
# cache — all built locally and specific to the GPU architecture and TensorRT
# version, so never tracked. The .names.json is generated ON-DEVICE beside its
# engine (TRT plans carry no name metadata), so it is exactly as untrackable as
# the engine: leaving it unignored made every Jetson checkout permanently dirty,
# which tools/build_package.sh correctly refuses to package.
models/*.engine
models/*.names.json
models/trt_cache/

# untracked local scratch + custom model (added by mistake once)
note.txt
models/digitv2.onnx
models/digitv2.engine.bak
