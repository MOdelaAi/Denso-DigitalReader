#!/bin/sh
# Structural setup, plus the forward-only upgrade gate.
#
# Everything with judgement (target user, autostart, autologin, validation)
# still lives in `denso-setup`, which the operator runs explicitly afterwards.
# The gate is the one exception, and it belongs here because this is the only
# point that runs BETWEEN "dpkg has replaced the binaries" and "the operator may
# start the app again". A newer binary against an unmigrated database is exactly
# the window that must not be left open.
#
# THIS SCRIPT MAY FAIL, deliberately reversing the previous "structural only,
# never fail" rule. The cost is understood: a failure leaves the package
# unconfigured and blocks later apt runs until the operator acts. That IS the
# fail-closed requirement — an upgrade whose backup, migration, or integrity
# verification failed must not quietly look successful. Every failure path is
# re-runnable with `dpkg --configure -a` once the cause is fixed.
#
# The decisions live in /opt/denso/lib/policy.sh (db_upgrade_gate and friends),
# where the test suite drives them directly. This file owns only install-layout
# knowledge: where things are, and which account owns the data.
set -e

DATA=/opt/denso/data
STATE=/opt/denso/install-state
# The packaged (read-only, dpkg-owned) side of the model store. Same values as
# denso-setup's PKG_MODELS/PKG_MANIFEST; both feed seed_manifest_decide.
PKG_MODELS=/opt/denso/models
PKG_MANIFEST=/opt/denso/lib/manifest.json
# "a fresh install started here and never finished" — see install_branch.
PENDING="$STATE/fresh-install-pending"
DB="$DATA/denso.db"
DENSO=/opt/denso/bin/denso
POLICY=/opt/denso/lib/policy.sh
HELPER=/opt/denso/lib/denso-db-helper
UNIT_NAME=denso-digitalreader.service
USER_UNIT=/usr/lib/systemd/user/$UNIT_NAME

case "$1" in
  configure)
    mkdir -p "$DATA/models" "$STATE"
    chmod 0755 "$STATE"

    # Ownership is NOT set here, on purpose: this ran on every upgrade (dpkg
    # never touches /opt/denso/data, so it was unnecessary), could be slow on
    # a large data tree, assumed the primary group is named after the user
    # (wrong — should be `id -gn`), and swallowed failure with `|| true`.
    # `denso-setup configure` owns initial ownership and repair instead.

    # EXISTING vs FRESH is decided by the recorded user FIRST, and only then by
    # the database. They answer different questions: an install that was
    # configured but never launched has a recorded user and no database yet, and
    # treating that as "fresh" would re-run the operator resolution and could
    # hand the appliance to a different administrator. A database with no
    # recorded user is the other anomaly, handled below.
    #
    # The third input is the fresh-install-pending marker, and it OVERRIDES both:
    # a fresh install that failed after configure recorded the user must resume
    # the fresh path on retry, not be laundered into an upgrade. The decision
    # itself lives in policy.sh, where the suite drives it directly.
    . "$POLICY"
    if [ "$(install_branch "$STATE/user" "$DB" "$PENDING")" = "upgrade" ]; then
        # Which account owns the data. Every database operation runs as this
        # user, never as root — see db_upgrade_gate's `runner` parameter.
        if [ -r "$STATE/user" ]; then
            user="$(cat "$STATE/user")"
        else
            # A database with no recorded user is an anomalous install, but
            # refusing outright would make it unupgradeable forever. The file's
            # own owner is a real, checkable answer.
            user="$(stat -c %U "$DB" 2>/dev/null || true)"
            [ -n "$user" ] && \
                echo "denso: note — no $STATE/user; using the database owner '$user'." >&2
        fi
        if [ -z "$user" ]; then
            echo "denso: UPGRADE HALTED: cannot determine which account owns $DB," >&2
            echo "denso: so database operations cannot be run as a non-root user." >&2
            echo "denso: Run 'sudo denso-setup configure --user <username>', then" >&2
            echo "denso: re-run 'sudo dpkg --configure -a'." >&2
            exit 1
        fi
        if ! id "$user" >/dev/null 2>&1; then
            echo "denso: UPGRADE HALTED: the target user '$user' does not exist." >&2
            echo "denso: After fixing the cause, re-run: sudo dpkg --configure -a" >&2
            exit 1
        fi

        # Persist a user recovered from the database owner, so the NEXT upgrade
        # reads it from install-state instead of re-deriving it. Never overwrite
        # an existing record — that file is what stops an upgrade being
        # re-pointed at whoever is running sudo today.
        if [ ! -r "$STATE/user" ]; then
            printf '%s\n' "$user" > "$STATE/user"
            echo "denso: recorded operator user '$user' in $STATE/user for future upgrades."
        fi

        # ── one-time migration off the old XDG-autostart architecture ────────
        # Guarded by a marker so a future upgrade can NEVER re-enable a service
        # the operator turned off with `systemctl --user disable`. An existing
        # install with no legacy entry is read as "autostart was deliberately
        # off" and is left disabled — a FRESH install is a different case and
        # never comes through here.
        home="$(getent passwd "$user" | cut -d: -f6 2>/dev/null || true)"
        if [ -n "$home" ] && [ -d "$home" ]; then
            case "$(migrate_xdg_autostart "$STATE" "$home" "$user" "$(id -gn "$user")" "$USER_UNIT" || echo error)" in
                enabled)
                    echo "denso: migrated autostart to the systemd user service (enabled for $user)." ;;
                preserved-disabled)
                    echo "denso: no previous Denso autostart entry — leaving the service DISABLED."
                    echo "denso: enable it with: systemctl --user enable --now denso-digitalreader" ;;
                already) : ;;
                *) echo "denso: WARNING — autostart migration did not complete; check" >&2
                   echo "denso: 'systemctl --user is-enabled denso-digitalreader' as $user." >&2 ;;
            esac
        fi

        # An UPGRADE deliberately does NOT re-run ownership, model seeding or
        # service enablement: the operator may have adjusted them, and dpkg has
        # not touched /opt/denso/data. Only the database gate runs.
        if [ -e "$DB" ]; then
            db_upgrade_gate "$DATA" "$DB" "$DENSO" "runuser -u $user --" "$HELPER" || exit 1
            echo "denso: upgrade complete. The application is stopped; start it when ready."
        else
            echo "denso: upgrade complete (no database yet). Operator user: $user."
        fi
        echo "denso:   systemctl --user status denso-digitalreader"
    else
        # ── FRESH INSTALL ────────────────────────────────────────────────────
        # A normal install must complete with `sudo apt install ./x.deb` alone,
        # so everything the operator used to run by hand happens here.
        #
        # Discriminated by install_branch (above), NOT on $DB alone: "has a
        # database" and "is configured" are different questions, and an install
        # that was configured but never started has no database yet.
        #
        # Mark the fresh install IN PROGRESS before anything durable is written.
        # Everything below - the recorded user, the data-dir ownership, the model
        # pairs, the enable symlink - outlives a failure, and $STATE/user alone
        # would make the next invocation believe this box was already configured.
        : > "$PENDING" || { echo "denso: cannot write $PENDING" >&2; exit 1; }

        # Local, ACTIVE, NON-REMOTE sessions belonging to a real user. Each
        # filter earns its place on this appliance: Class=user drops the GDM
        # greeter (which runs as the `gdm` system account and would otherwise be
        # the only "graphical" session on the box), and Remote=no drops the
        # administrator's own SSH session — resolving to whoever SSH'd in is
        # exactly the wrong answer when they are installing FOR someone else.
        sessions=""
        if command -v loginctl >/dev/null 2>&1; then
            for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
                [ "$(loginctl show-session "$s" -p Class  --value 2>/dev/null)" = "user"   ] || continue
                [ "$(loginctl show-session "$s" -p Remote --value 2>/dev/null)" = "no"     ] || continue
                [ "$(loginctl show-session "$s" -p State  --value 2>/dev/null)" = "active" ] || continue
                n="$(loginctl show-session "$s" -p Name --value 2>/dev/null)"
                [ -n "$n" ] && sessions="$sessions $n"
            done
        fi

        # The recorded user is passed FIRST so a retry of an unfinished fresh
        # install resolves to the account this box was already configured for.
        # `dpkg --configure -a` runs with no SUDO_USER and no session of its own,
        # so without this a retry could not resolve an operator at all. An
        # invalid recorded user still hard-fails inside resolve_operator_user -
        # it never falls through to whoever ran sudo.
        recorded="$(cat "$STATE/user" 2>/dev/null || true)"
        # shellcheck disable=SC2086
        if ! resolved="$(resolve_operator_user /etc/passwd "$recorded" "${SUDO_USER-}" $sessions)"; then
            echo "denso: INSTALLATION HALTED: no operator user could be determined." >&2
            echo "denso: Denso will not install itself against root or a guessed account." >&2
            echo "denso: Re-run as 'sudo apt install ./<deb>' from the operator's own" >&2
            echo "denso: session, or install and then run:" >&2
            echo "denso:   sudo denso-setup configure --user <username> --autostart" >&2
            exit 1
        fi
        user="${resolved%% *}"
        rule="${resolved##* }"

        if ! id "$user" >/dev/null 2>&1; then
            echo "denso: INSTALLATION HALTED: resolved user '$user' does not exist." >&2
            exit 1
        fi

        # Reuse denso-setup rather than reimplementing ownership, model seeding
        # and the autostart entry here. It is the tool that was verified on
        # hardware; a second copy of that logic in a maintainer script is a
        # second thing to keep correct. --enable-autologin is NEVER passed.
        if ! denso-setup configure --user "$user" --autostart --auto; then
            echo "denso: INSTALLATION HALTED: configuring for '$user' failed." >&2
            echo "denso: After fixing the cause, re-run: sudo dpkg --configure -a" >&2
            exit 1
        fi

        # ── manifest seeding ───────────────────────────────────────────
        # `configure` has just placed the packaged engine+sidecar pairs. Without
        # manifest.json BESIDE them every artifact reads back as
        # `model_undeclared`: the camera wizard offers nothing, `--check` reports
        # DEGRADED, and the install still looks successful. That combination
        # shipped, and cost an appliance its first hour.
        #
        # Scoped to THIS branch deliberately. The "operator-invoked only" rule
        # (denso-setup, cmd_seed_manifest) exists so package-delivered
        # enforcement cannot declare artifacts an OPERATOR placed. On a fresh
        # install there is no operator history to respect - this same run seeded
        # those exact bytes from this same package - and seed_manifest_decide
        # still refuses independently the moment anything in the data dir is not
        # the packaged artifact. Upgrades are untouched and still require an
        # explicit `sudo denso-setup seed-manifest`.
        fail=""
        set +e
        sm_decision="$(seed_manifest_decide "$PKG_MANIFEST" "$PKG_MODELS" \
                                            "$DATA/models" "$DATA/models/manifest.json")"
        set -e
        case "$(fresh_seed_action "$sm_decision")" in
            act)
                denso-setup seed-manifest \
                    || fail="$fail\n  seeding $DATA/models/manifest.json failed (decision '$sm_decision')" ;;
            warn)
                # Refusing to seed is the CORRECT outcome here, so this is not a
                # failure - but it is not silence either: the box boots with
                # undeclared models and the operator has to know why.
                echo "denso: NOTE  models/manifest.json was NOT seeded ($sm_decision)." >&2
                echo "denso:       An artifact in $DATA/models is not the packaged one, so the" >&2
                echo "denso:       packaged manifest would misdescribe it. Nothing was overwritten." >&2
                echo "denso:       Models stay undeclared until you resolve that and run:" >&2
                echo "denso:         sudo denso-setup seed-manifest" >&2 ;;
            *)
                fail="$fail\n  the packaged model manifest is unusable ($sm_decision)" ;;
        esac

        # ── setup verification ───────────────────────────────────────────────
        # Deliberately NOT `denso-setup verify`: that asserts L4T/TensorRT/CUDA
        # versions, probes GStreamer elements and deep-loads every engine. Those
        # are the right checks for an operator gate, but failing an INSTALL on
        # them would reject a correctly-installed package for reasons that have
        # nothing to do with whether setup completed. What is checked here is
        # exactly "did setup complete", plus the app's own health verdict.
        [ "$(cat "$STATE/user" 2>/dev/null || true)" = "$user" ] \
            || fail="$fail\n  the operator user was not recorded in $STATE/user"
        [ "$(stat -c %U "$DATA" 2>/dev/null || true)" = "$user" ] \
            || fail="$fail\n  $DATA is not owned by $user"
        home="$(getent passwd "$user" | cut -d: -f6)"
        link="$(user_unit_wants_link "$home" "$UNIT_NAME")"
        [ -L "$link" ] || fail="$fail\n  the service is not enabled ($link is missing)"
        [ "$(readlink "$link" 2>/dev/null || true)" = "$USER_UNIT" ] \
            || fail="$fail\n  $link does not point at $USER_UNIT"
        [ "$(stat -c %U "$link" 2>/dev/null || true)" = "$user" ] \
            || fail="$fail\n  the enable symlink is not owned by $user"
        # Belt and braces: the old authority must not exist on a fresh install.
        [ -e "$home/.config/autostart/com.denso.DigitalReader.desktop" ] \
            && fail="$fail\n  a legacy XDG autostart entry is present"

        set +e
        runuser -u "$user" -- env DENSO_DATA_DIR="$DATA" "$DENSO" --check
        rc=$?
        set -e
        verdict="$(check_verdict "$rc")"
        case "$verdict" in
            ok|degraded) : ;;
            *) fail="$fail\n  denso --check reported '$verdict' (rc=$rc)" ;;
        esac

        if [ -n "$fail" ]; then
            # No success line is printed on this path. A fresh install that could
            # not be verified must never look configured.
            echo "denso: INSTALLATION HALTED: setup did not verify:" >&2
            # shellcheck disable=SC2059
            printf "$fail\n" >&2
            echo "denso: The package is left unconfigured. After fixing the cause:" >&2
            echo "denso:   sudo dpkg --configure -a" >&2
            exit 1
        fi

        # Verified. Clearing the marker is what makes this install "finished":
        # until this line runs, every retry resumes the fresh path. It is
        # deliberately AFTER the $fail gate above and BEFORE the success banner,
        # so no path can announce success with the marker still present.
        rm -f "$PENDING" || {
            echo "denso: INSTALLATION HALTED: cannot clear $PENDING" >&2
            echo "denso: After fixing the cause, re-run: sudo dpkg --configure -a" >&2
            exit 1
        }

        # A fresh install is already on the systemd architecture, so record the
        # migration as done. Without this, the NEXT upgrade would run the legacy
        # migration, find no XDG entry, and log a misleading
        # "leaving the service DISABLED" for an install that is in fact enabled.
        printf '%s\n' "fresh-install" > "$STATE/autostart-migrated" || true

        echo "denso: fresh installation configured."
        echo "denso: operator user: $user"
        echo "denso: autostart: enabled"
        echo "denso: autologin: unchanged"
        if [ "$verdict" = "degraded" ]; then
            echo "denso: health: DEGRADED (serviceable) — at least one model is not usable."
            echo "denso:   'sudo denso-setup verify' says which. If models report"
            echo "denso:   model_undeclared, run 'sudo denso-setup seed-manifest'."
        fi
        case "$rule" in
            sudo_user) : ;;
            session)   echo "denso: (operator resolved from the active local session)" ;;
            recorded)  echo "denso: (operator resolved from the recorded install state)" ;;
        esac
        echo "denso: Denso starts at the operator's next graphical login."
        echo "denso:   systemctl --user status denso-digitalreader"
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
  *)
    echo "denso: unexpected maintainer-script argument: $1" >&2
    exit 1
    ;;
esac

exit 0
